# ===== 知行工作台 v3.0 .gitignore =====

# Python 编译产物
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# PyInstaller 构建
build/
dist/
*.spec.bak
*.manifest
*.log

# ===== 用户个人数据（绝对不能进仓库）=====
data/
*.db
*.sqlite
*.sqlite3
.vault/
.secrets

# 虚拟环境
venv/
.venv/
env/
ENV/

# IDE / OS 产物
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本地环境变量 / 密钥
.env
.env.local
*.local

# 临时备份文件（不进仓库）
*.bak
*.bak*
*.bak_*
*.backup_*

# ===== v3.2 额外排除 =====
# PyInstaller 编号构建/输出目录 (build2~19, dist2~19)
build*/
dist*/

# MSIX 打包临时目录 (build_msix_v2.py 生成)
msix_staging/

# macOS 残留
.DS_Store